{
  "name": "GoToSleep",
  "description": "Free up memory",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": "sleep.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "tabs",
    "scripting",
    "processes"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
